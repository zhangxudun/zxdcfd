# 用户和访问码: 名:码，多人用英文逗号隔开。不填就是单机模式（谁打开都能用，不要这样放到公网）。
ZXDCFD_USERS=张三:改成随机长码1,李四:改成随机长码2
# 管理员能看到、取消、删除所有人的任务
ZXDCFD_ADMINS=张三
# 同时计算几个任务（每个任务约占 1 核、1~2 GB 内存）
ZXDCFD_WORKERS=1
# 每人同时最多几个未结束的任务
ZXDCFD_MAX_JOBS_PER_USER=2
# 网格单元上限、单次求解时限（秒）
ZXDCFD_MAX_CELLS=400000
ZXDCFD_MAX_TIME=7200
# 任务结束后保留几天
ZXDCFD_KEEP_DAYS=7
# https 用的域名（用 --profile https 时才需要），域名要先解析到服务器 IP
DOMAIN=cfd.example.com
